# ── CIVICXON backend environment ─────────────────────────────
# Copy to .env and fill in. NEVER commit .env.
DATABASE_URL=postgresql+psycopg2://civicxon:civicxon@localhost:5432/civicxon
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=./uploads
STORAGE_BACKEND=local            # local | s3 (s3 requires boto3 + bucket vars)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=                 # e.g. http://localhost:9000 for MinIO
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Gemma 4 via Google AI Studio (https://aistudio.google.com/apikey).
# LEAVE EMPTY to run without live AI — the API then returns explicit stub analyzer labels.
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it   # or gemma-4-31b-it
GEMMA_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
AUTO_ASSIGN=true
ALLOCATION_WEIGHTS={"skill":45,"distance":25,"workload":20,"availability":10}
